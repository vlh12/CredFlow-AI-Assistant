server.address=127.0.0.1
spring.datasource.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
spring.datasource.username=CF_AUTH
spring.datasource.password=CHANGE_ME
spring.jpa.hibernate.ddl-auto=validate
spring.kafka.bootstrap-servers=127.0.0.1:9092
credflow.jwt.issuer=credflow-auth
credflow.jwt.audience=credflow-api
credflow.jwt.public-key-path=C:/credflow/CredFlow/backend/runtime/private/auth-public.pem
credflow.jwt.private-key-path=C:/credflow/CredFlow/backend/runtime/private/auth-private.pem

# Local Ollama assistant (no provider API key)
credflow.assistant.ollama-url=http://127.0.0.1:11434
credflow.assistant.model=qwen3:1.7b
credflow.assistant.timeout-seconds=45
